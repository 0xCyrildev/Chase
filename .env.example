# Chase reads no secrets unless you ask it to explain findings or run the scout in real mode.
# Copy to .env — .env is gitignored and is never included in the published package.

# Network used when a command is not given --network explicitly (mainnet | testnet | devnet).
SUI_NETWORK=mainnet

# Required only by `chase triage --explain` and `chase hunt --mode real`.
# Any OpenAI-compatible chat-completions endpoint works.
LLM_API_KEY=
LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=

# Optional: where traces and cached Move function signatures are stored.
# Defaults to ~/.cache/chase
# CHASE_CACHE_DIR=/absolute/path

# Optional: gRPC endpoints. Leave these unset to use the public Sui fullnodes.
# Set them to point Chase at a provider (Triton, Quicknode, etc.) or your own node —
# the only way to analyse history beyond the ~21-day public retention window.
# Must be https; anything else is refused at startup rather than failing per transaction.
# SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
# SUI_ARCHIVE_URL=https://archive.mainnet.sui.io:443
